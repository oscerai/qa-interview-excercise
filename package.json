    "test:watch": "vitest",
    "verify": "vitest run && node -e \"console.log('\\n✓ Setup OK — run npm run dev and open http://localhost:3000\\n')\""
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
